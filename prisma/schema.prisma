generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("client")
  credits      Int      @default(100)
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accounts     ConnectedAccount[]
  tasks        Task[]
  posts        Post[]
  agentRuns    AgentRun[]
  conversations Conversation[]
  creditTxns   CreditTransaction[]
  scheduledJobs ScheduledJob[]
}

model SiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  category    String
  label       String
  description String?
  type        String   @default("text")
  isSecret    Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       String?
  createdAt      DateTime     @default(now())
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  type        String
  description String?
  razorpayId  String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())
}

model CreditPackage {
  id               String   @id @default(cuid())
  name             String
  credits          Int
  priceInr         Int
  originalPriceInr Int?
  badge            String?
  features         String?
  billingPeriod    String   @default("one-time")
  highlight        Boolean  @default(false)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
}

model SubscriptionPlan {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  priceInr         Int
  originalPriceInr Int?
  creditsPerMonth  Int
  billingPeriod    String   @default("monthly")
  badge            String?
  features         String?
  popular          Boolean  @default(false)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
}

model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  String   @default("percent")
  discountValue Int      @default(0)
  bonusCredits  Int      @default(0)
  maxUses       Int      @default(0)
  usedCount     Int      @default(0)
  minPurchase   Int      @default(0)
  expiresAt     DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  redemptions   PromoRedemption[]
}

model PromoRedemption {
  id        String    @id @default(cuid())
  userId    String
  promoId   String
  promo     PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  members   User[]
}

model ScheduledJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId      String?
  platform    String   @default("instagram")
  payload     String
  scheduledAt DateTime
  status      String   @default("pending")
  executedAt  DateTime?
  error       String?
  createdAt   DateTime @default(now())
}

model ConnectedAccount {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String   @default("instagram")
  username        String
  displayName     String?
  profilePicture  String?
  accountId       String   @unique
  accessToken     String
  followers       Int      @default(0)
  following       Int      @default(0)
  postsCount      Int      @default(0)
  bio             String?
  tokenExpiresAt  DateTime?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  posts           Post[]
}

model Task {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String
  title       String
  status      String   @default("pending")
  type        String   @default("general")
  result      String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption     String
  hashtags    String?
  imageUrl    String?
  status      String   @default("draft")
  platforms   String?
  scheduledAt DateTime?
  publishedAt DateTime?
  accountId   String?
  account     ConnectedAccount? @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentRun {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  status    String      @default("thinking")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  steps     AgentStep[]
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  phase     String
  title     String
  content   String
  status    String   @default("running")
  order     Int
  createdAt DateTime @default(now())
}

model ApiKeyEntry {
  id        String    @id @default(cuid())
  provider  String
  label     String
  keyValue  String
  status    String    @default("unknown")
  priority  Int       @default(0)
  isActive  Boolean   @default(true)
  isCustom  Boolean   @default(false)
  endpoint  String?
  metadata  String?
  lastCheck DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ShowcaseItem {
  id           String   @id @default(cuid())
  type         String
  title        String
  subtitle     String?
  mediaUrl     String
  thumbnailUrl String?
  category     String
  badge        String?
  linkUrl      String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}
